FROM vllm/vllm-openai-cpu:latest-x86_64

ARG MODEL_ID="Qwen/Qwen3.5-0.8B"
ARG MODEL_DIR="/models/Qwen3.5-0.8B-Instruct"

WORKDIR /app

RUN groupadd --system app && \
    useradd --system --create-home --home-dir /app --gid app app && \
    mkdir -p /models && \
    chown -R app:app /app /models

ENV MODEL_ID="${MODEL_ID}"
ENV MODEL_DIR="${MODEL_DIR}"

RUN python3 -c "from huggingface_hub import snapshot_download; import os; snapshot_download(repo_id=os.environ['MODEL_ID'], local_dir=os.environ['MODEL_DIR'], local_dir_use_symlinks=False)"
RUN chown -R app:app /models

USER app

ENV HF_HUB_OFFLINE=1
ENV TRANSFORMERS_OFFLINE=1

EXPOSE 8000

ENTRYPOINT ["sh", "-c", "exec vllm serve \"$MODEL_DIR\" --host 0.0.0.0 --port 8000 \"$@\"", "--"]
CMD []
